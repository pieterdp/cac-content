<def-group>
  <definition class="inventory" id="installed_OS_is_linuxmint" version="1">
    <metadata>
      <title>Linux Mint</title>
      <affected family="unix">
        <platform>multi_platform_all</platform>
      </affected>
      <description>The operating system installed is an Linux Mint System</description>
    </metadata>
    <criteria comment="System is Linux Mint" operator="AND">
      <extend_definition comment="Installed OS is part of the Unix family" definition_ref="installed_OS_is_part_of_Unix_family" />
      <criterion comment="lsb-based distrib" test_ref="test_lsb" />
      <criterion comment="Linux Mint is installed" test_ref="test_linuxmint" />
    </criteria>
  </definition>

  <unix:file_test check="all" check_existence="all_exist" comment="/etc/lsb-release exists" id="test_lsb" version="1">
    <unix:object object_ref="obj_lsb" />
  </unix:file_test>
  <unix:file_object comment="check /etc/lsb-release file" id="obj_lsb" version="1">
    <unix:filepath>/etc/lsb-release</unix:filepath>
  </unix:file_object>

  <ind:textfilecontent54_test check="all" check_existence="at_least_one_exists" comment="Check Linux Mint" id="test_linuxmint" version="1">
    <ind:object object_ref="obj_linuxmint" />
  </ind:textfilecontent54_test>
  <ind:textfilecontent54_object id="obj_linuxmint" version="1" comment="Check Linux Mint">
    <ind:filepath>/etc/lsb-release</ind:filepath>
    <ind:pattern operation="pattern match">^DISTRIB_ID=LinuxMint$</ind:pattern>
    <ind:instance datatype="int">1</ind:instance>
  </ind:textfilecontent54_object>

</def-group>
